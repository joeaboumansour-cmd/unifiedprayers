# Supabase — Dashboard → Project Settings → API
# Both of these are public: they ship in the browser bundle and are safe to
# commit to a private repo / paste into Vercel. Row Level Security is what
# protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The secret key (sb_secret_...), from Dashboard → Project Settings → API Keys.
# It bypasses every RLS policy: never commit it, never let it reach a browser.
# Needed by the admin scripts you run yourself AND, since notifications, by the
# server at runtime — the /api/push routes read and write push_subscriptions,
# which has RLS on and no policies at all. Set it in Vercel as well.
SUPABASE_SECRET_KEY=

# Web Push — run `npm run vapid` once and paste the output here.
# The public key ships in the browser bundle by design; every subscription is
# bound to it, so regenerating the pair invalidates every device already
# subscribed. Generate once and keep it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real mailto: or https: address. Push services use it to reach the sender,
# and Apple refuses a subscription without one.
VAPID_SUBJECT=mailto:you@example.com

# Guards /api/cron/notifications, which sends to every subscriber. Any random
# string; the same value goes in supabase/schedule.sql. With this unset the
# endpoint refuses every caller, so nothing scheduled is ever delivered.
CRON_SECRET=
