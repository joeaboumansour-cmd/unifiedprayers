# Supabase — Dashboard → Project Settings → API
# Both of these are public: they ship in the browser bundle and are safe to
# commit to a private repo / paste into Vercel. Row Level Security is what
# protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Never commit a service_role key. Nothing in this app needs one — it is only
# used by admin scripts you run yourself, and it bypasses every RLS policy.
